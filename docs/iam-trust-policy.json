{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSentinelAIAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<SENTINELAI_DEPLOYMENT_ACCOUNT_ID>:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<A_RANDOM_SECRET_YOU_CHOOSE>"
        }
      }
    }
  ]
}
