# ── Application ──────────────────────────────────────────────
# Values below are development defaults. Production example values are
# shown in comments next to each setting that changes for deployment.
APP_NAME=SentinelAI
APP_ENV=development
# Production: APP_ENV=production
DEBUG=true
# Production: DEBUG=false
API_V1_PREFIX=/api/v1

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Used to encrypt stored AWS static access keys at rest (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=change-me-fernet-key

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sentinelai.db
# Production: DATABASE_URL=sqlite:////var/lib/sentinelai/sentinelai.db
# Production schema management uses Alembic — run `alembic upgrade head`
# instead of relying on the app's create_all() convenience path.

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Groq AI ──────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
# Maximum number of findings/resources included in one AI tool result.
AI_TOOL_RESULT_LIMIT=25
AI_OBSERVABILITY_ENABLED=true
AI_LOG_SENSITIVE_DATA=false
AI_METRICS_ENABLED=true

# FastEmbed's compact ONNX English semantic-search model (~67 MB model files).
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_INDEX_DIR=./data/rag
# Production: RAG_INDEX_DIR=/var/lib/sentinelai/rag
RAG_TOP_K=5
RAG_SEMANTIC_CANDIDATE_K=10
RAG_KEYWORD_CANDIDATE_K=10
RAG_RERANK_CANDIDATE_K=15
RAG_FINAL_TOP_K=5
RAG_RERANK_ENABLED=true
# FastEmbed ONNX cross-encoder (~80 MB); only scores the fused candidate set.
RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Directory FastEmbed caches downloaded ONNX model files in.
FASTEMBED_CACHE_DIR=./.fastembed_cache
# Production: FASTEMBED_CACHE_DIR=/var/lib/sentinelai/models

# ── Reports ────────────────────────────────────────────────────
# Directory generated PDF/CSV/JSON audit reports are written to.
SENTINELAI_REPORTS_DIR=./generated_reports
# Production: SENTINELAI_REPORTS_DIR=/var/lib/sentinelai/reports

# ── AWS (defaults; per-account overrides stored in DB) ────────
AWS_DEFAULT_REGION=us-east-1
